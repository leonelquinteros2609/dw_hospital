		{
			"name": "[concat(parameters('factoryName'), '/df_silver_admissions')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Limpieza y validacion de admisiones para la capa Silver",
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_bronze_admissions",
								"type": "DatasetReference"
							},
							"name": "OrigenAdmisiones"
						},
						{
							"dataset": {
								"referenceName": "ds_silver_patients",
								"type": "DatasetReference"
							},
							"name": "OrigenPacientes"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_silver_admissions",
								"type": "DatasetReference"
							},
							"name": "DestinoAdmisiones"
						}
					],
					"transformations": [
						{
							"name": "LimpiarAdmisiones"
						},
						{
							"name": "FiltrarAdmisiones"
						},
						{
							"name": "CorregirAlta"
						},
						{
							"name": "ValidarPaciente"
						}
					],
					"scriptLines": [
						"source(output(",
						"          admission_id as string,",
						"          patient_id as string,",
						"          admission_date as string,",
						"          discharge_date as string,",
						"          department as string,",
						"          attending_doctor_id as string",
						"     ),",
						"     allowSchemaDrift: false,",
						"     validateSchema: true,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> OrigenAdmisiones",
						"source(output(",
						"          patient_id as integer,",
						"          full_name as string,",
						"          gender as string,",
						"          date_of_birth as date,",
						"          phone as string,",
						"          email as string,",
						"          address as string,",
						"          insurance_provider as string",
						"     ),",
						"     allowSchemaDrift: false,",
						"     validateSchema: true,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> OrigenPacientes",
						"OrigenAdmisiones derive(admission_id = toInteger(trim(admission_id)),",
						"          patient_id = toInteger(trim(patient_id)),",
						"          attending_doctor_id = toInteger(trim(attending_doctor_id)),",
						"          admission_date = coalesce(",
						"          toDate(trim(admission_date), 'yyyy-MM-dd'),",
						"          toDate(trim(admission_date), 'dd-MMM-yyyy'),",
						"          toDate(trim(admission_date), 'MMMM dd, yyyy'),",
						"          toDate(trim(admission_date), 'MM/dd/yyyy'),",
						"          toDate(trim(admission_date), 'MM-dd-yyyy')",
						"     ),",
						"          discharge_date = coalesce(",
						"          toDate(trim(discharge_date), 'yyyy-MM-dd'),",
						"          toDate(trim(discharge_date), 'dd-MMM-yyyy'),",
						"          toDate(trim(discharge_date), 'MMMM dd, yyyy'),",
						"          toDate(trim(discharge_date), 'MM/dd/yyyy'),",
						"          toDate(trim(discharge_date), 'MM-dd-yyyy')",
						"     ),",
						"          department = toString(initCap(trim(department)))) ~> LimpiarAdmisiones",
						"LimpiarAdmisiones filter(!isNull(admission_id) &&",
						"     !isNull(patient_id) &&",
						"     !isNull(admission_date) &&",
						"     !isNull(attending_doctor_id) &&",
						"     !isNull(department) &&",
						"     department != '') ~> FiltrarAdmisiones",
						"FiltrarAdmisiones derive(discharge_date = iif(",
						"          !isNull(discharge_date) && discharge_date < admission_date,",
						"          toDate(null()),",
						"          discharge_date",
						"     )) ~> CorregirAlta",
						"CorregirAlta, OrigenPacientes exists(toString(byName('patient_id', 'CorregirAlta')) == toString(byName('patient_id', 'OrigenPacientes')),",
						"     negate:false,",
						"     broadcast: 'right')~> ValidarPaciente",
						"ValidarPaciente sink(allowSchemaDrift: false,",
						"     validateSchema: true,",
						"     input(",
						"          admission_id as integer,",
						"          patient_id as integer,",
						"          admission_date as date,",
						"          discharge_date as date,",
						"          department as string,",
						"          attending_doctor_id as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> DestinoAdmisiones"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_bronze_admissions')]",
				"[concat(variables('factoryId'), '/datasets/ds_silver_patients')]",
				"[concat(variables('factoryId'), '/datasets/ds_silver_admissions')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_silver_billing')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Limpieza y validacion de facturacion para la capa Silver",
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_bronze_billing",
								"type": "DatasetReference"
							},
							"name": "OrigenFacturacion"
						},
						{
							"dataset": {
								"referenceName": "ds_silver_admissions",
								"type": "DatasetReference"
							},
							"name": "OrigenAdmisiones"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_silver_billing",
								"type": "DatasetReference"
							},
							"name": "DestinoFacturacion"
						}
					],
					"transformations": [
						{
							"name": "SeleccionarAdmision"
						},
						{
							"name": "LimpiarFacturacion"
						},
						{
							"name": "FiltrarFacturacion"
						},
						{
							"name": "ValidarAdmision"
						}
					],
					"scriptLines": [
						"source(output(",
						"          billing_id as string,",
						"          admission_id as string,",
						"          charge_type as string,",
						"          amount as string,",
						"          payment_status as string,",
						"          payment_date as string",
						"     ),",
						"     allowSchemaDrift: false,",
						"     validateSchema: true,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> OrigenFacturacion",
						"source(output(",
						"          admission_id as integer,",
						"          patient_id as integer,",
						"          admission_date as date,",
						"          discharge_date as date,",
						"          department as string,",
						"          attending_doctor_id as integer",
						"     ),",
						"     allowSchemaDrift: false,",
						"     validateSchema: true,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> OrigenAdmisiones",
						"OrigenAdmisiones select(mapColumn(",
						"          IdAdmisionValida = admission_id",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SeleccionarAdmision",
						"OrigenFacturacion derive(billing_id = toInteger(trim(billing_id)),",
						"          admission_id = toInteger(trim(admission_id)),",
						"          charge_type = toString(iif(isNull(charge_type) || trim(charge_type) == '', 'Sin especificar', initCap(trim(charge_type)))),",
						"          amount = toDecimal(regexReplace(trim(amount), `[^0-9.-]`, ''), 12, 2),",
						"          payment_status = toString(case(",
						"        lower(trim(payment_status)) == 'paid', 'Paid',",
						"        lower(trim(payment_status)) == 'unpaid', 'Unpaid',",
						"        lower(trim(payment_status)) == 'pending', 'Pending',",
						"        lower(trim(payment_status)) == 'overdue', 'Overdue',",
						"        isNull(payment_status) || trim(payment_status) == '', 'Sin especificar',",
						"        initCap(trim(payment_status))",
						"    )),",
						"          payment_date = coalesce(",
						"        toDate(trim(payment_date), 'yyyy-MM-dd'),",
						"        toDate(trim(payment_date), 'MM/dd/yyyy'),",
						"        toDate(trim(payment_date), 'dd-MMM-yyyy'),",
						"        toDate(trim(payment_date), 'MMMM dd, yyyy'),",
						"        toDate(trim(payment_date), 'MM-dd-yy')",
						"    )) ~> LimpiarFacturacion",
						"LimpiarFacturacion filter(!isNull(billing_id) &&",
						"    !isNull(admission_id) &&",
						"    !isNull(amount) &&",
						"    !isNull(charge_type) &&",
						"    !isNull(payment_status)) ~> FiltrarFacturacion",
						"FiltrarFacturacion, SeleccionarAdmision exists(admission_id == IdAdmisionValida,",
						"     negate:false,",
						"     broadcast: 'auto')~> ValidarAdmision",
						"ValidarAdmision sink(allowSchemaDrift: false,",
						"     validateSchema: true,",
						"     input(",
						"          billing_id as integer,",
						"          admission_id as integer,",
						"          charge_type as string,",
						"          amount as decimal(12,2),",
						"          payment_status as string,",
						"          payment_date as date",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> DestinoFacturacion"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_bronze_billing')]",
				"[concat(variables('factoryId'), '/datasets/ds_silver_admissions')]",
				"[concat(variables('factoryId'), '/datasets/ds_silver_billing')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_silver_diagnoses')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Limpieza y validacion de diagnosticos para la capa Silver",
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_bronze_diagnoses",
								"type": "DatasetReference"
							},
							"name": "OrigenDiagnosticos"
						},
						{
							"dataset": {
								"referenceName": "ds_silver_admissions",
								"type": "DatasetReference"
							},
							"name": "OrigenAdmisiones"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_silver_diagnoses",
								"type": "DatasetReference"
							},
							"name": "DestinoDiagnosticos"
						}
					],
					"transformations": [
						{
							"name": "LimpiarDiagnosticos"
						},
						{
							"name": "FiltrarDiagnosticos"
						},
						{
							"name": "ValidarAdmision"
						}
					],
					"scriptLines": [
						"source(output(",
						"          diagnosis_id as string,",
						"          admission_id as string,",
						"          icd_code as string,",
						"          diagnosis_description as string,",
						"          severity as string",
						"     ),",
						"     allowSchemaDrift: false,",
						"     validateSchema: true,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> OrigenDiagnosticos",
						"source(output(",
						"          admission_id as integer,",
						"          patient_id as integer,",
						"          admission_date as date,",
						"          discharge_date as date,",
						"          department as string,",
						"          attending_doctor_id as integer",
						"     ),",
						"     allowSchemaDrift: false,",
						"     validateSchema: true,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> OrigenAdmisiones",
						"OrigenDiagnosticos derive(diagnosis_id = toInteger(trim(diagnosis_id)),",
						"          admission_id = toInteger(trim(admission_id)),",
						"          icd_code = upper(trim(icd_code)),",
						"          diagnosis_description = trim(diagnosis_description),",
						"          severity = toString(case(",
						"          isNull(severity) || trim(severity) == '', 'No especificada',",
						"          lower(trim(severity)) == 'mild', 'Leve',",
						"          lower(trim(severity)) == 'moderate', 'Moderado',",
						"          lower(trim(severity)) == 'severe', 'Grave',",
						"          lower(trim(severity)) == 'critical', 'Critico',",
						"          initCap(trim(severity))",
						"     ))) ~> LimpiarDiagnosticos",
						"LimpiarDiagnosticos filter(!isNull(diagnosis_id) &&",
						"     !isNull(admission_id) &&",
						"     !isNull(icd_code) &&",
						"     trim(icd_code) != '') ~> FiltrarDiagnosticos",
						"FiltrarDiagnosticos, OrigenAdmisiones exists(toInteger(byName('admission_id','FiltrarDiagnosticos')) == toInteger(byName('admission_id','OrigenAdmisiones')),",
						"     negate:false,",
						"     broadcast: 'right')~> ValidarAdmision",
						"ValidarAdmision sink(allowSchemaDrift: false,",
						"     validateSchema: true,",
						"     input(",
						"          diagnosis_id as integer,",
						"          admission_id as integer,",
						"          icd_code as string,",
						"          diagnosis_description as string,",
						"          severity as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> DestinoDiagnosticos"
					]
				}
			},
