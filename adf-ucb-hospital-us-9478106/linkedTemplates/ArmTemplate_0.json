		{
			"name": "[concat(parameters('factoryName'), '/df_silver_patients')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_bronze_patients",
								"type": "DatasetReference"
							},
							"name": "srcpatients"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_silver_patients",
								"type": "DatasetReference"
							},
							"name": "snkpatients"
						}
					],
					"transformations": [
						{
							"name": "drvpatients"
						},
						{
							"name": "fltvalidacionpatients"
						}
					],
					"scriptLines": [
						"source(output(",
						"          patient_id as string,",
						"          full_name as string,",
						"          gender as string,",
						"          date_of_birth as string,",
						"          phone as string,",
						"          email as string,",
						"          address as string,",
						"          insurance_provider as string",
						"     ),",
						"     allowSchemaDrift: false,",
						"     validateSchema: true,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> srcpatients",
						"srcpatients derive(patient_id = toInteger(trim(patient_id)),",
						"          full_name = trim(full_name),",
						"          gender = toString(iif(in(['m','male','masculino'], lower(trim(gender))), 'Masculino', iif(in(['f','female','femenino'], lower(trim(gender))), 'Femenino', toString(null())))),",
						"          date_of_birth = iif(isNull(date_of_birth) || trim(date_of_birth) == '', toDate(null()),",
						"         iif(regexMatch(trim(date_of_birth), `^[0-9]{2}-[0-9]{2}-[0-9]{2}$`),",
						"             toDate(concat(iif(toInteger(right(trim(date_of_birth), 2)) <= 26, '20', '19'), right(trim(date_of_birth), 2), '-', left(trim(date_of_birth), 2), '-', substring(trim(date_of_birth), 4, 2)), 'yyyy-MM-dd'),",
						"             coalesce(toDate(trim(date_of_birth), 'yyyy-MM-dd'),",
						"                      toDate(trim(date_of_birth), 'MMMM dd, yyyy'),",
						"                      toDate(trim(date_of_birth), 'dd-MMM-yyyy'),",
						"                      toDate(trim(date_of_birth), 'MM/dd/yyyy')))),",
						"          phone = toString(iif(isNull(phone) || in(['','unknown','n/a','null','none'], lower(trim(phone))), toString(null()), trim(phone))),",
						"          email = toString(iif(isNull(email) || in(['','unknown','n/a','null','none'], lower(trim(email))), toString(null()), lower(replace(trim(email), ',', '.')))),",
						"          address = trim(address),",
						"          insurance_provider = toString(iif(isNull(insurance_provider) || in(['','unknown','n/a','null','none'], lower(trim(insurance_provider))), toString(null()), upper(trim(insurance_provider))))) ~> drvpatients",
						"drvpatients filter(!isNull(patient_id) && !isNull(full_name) && full_name != '') ~> fltvalidacionpatients",
						"fltvalidacionpatients sink(allowSchemaDrift: false,",
						"     validateSchema: true,",
						"     input(",
						"          patient_id as integer,",
						"          full_name as string,",
						"          gender as string,",
						"          date_of_birth as date,",
						"          phone as string,",
						"          email as string,",
						"          address as string,",
						"          insurance_provider as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> snkpatients"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_bronze_patients')]",
				"[concat(variables('factoryId'), '/datasets/ds_silver_patients')]"
			]
		},
